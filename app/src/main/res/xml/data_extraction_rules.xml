<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules (API 31+): the session credential lives in
  the app's no-backup directory, which the platform already keeps
  out of cloud backup and device transfer. These rules exclude the
  same path again, on both surfaces, so the exclusion does not rest
  on any single layer — SimpMusic's Phase-2 anti-pattern was a
  legacy-rules hole that left the credential backup-eligible on
  API 26–30; here both rule sets exclude it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
